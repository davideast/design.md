---
import Base from "../../../../layouts/Base.astro";
import TopRail from "../../../../components/TopRail.astro";
import { listCases, caseView, renderingView } from "../../../../lib/runs";
import BrowserFrame from "../../../../components/BrowserFrame.astro";
import { marked } from "marked";

export function getStaticPaths() {
  const paths: any[] = [];
  for (const c of listCases()) {
    const v = caseView(c.key)!;
    for (const t of v.treatments) {
      if (t.samplePath) paths.push({ params: { case: c.key, treatment: t.key, n: "0" } });
    }
  }
  return paths;
}
const { case: caseKey, treatment, n } = Astro.params;
const r = renderingView(caseKey!, treatment!, Number(n))!;
const exactWordsHtml = marked.parse(r.exactWords);
---
<Base title={`${r.treatmentName} — ${r.caseTitle} — Design Bench`}>
  <TopRail active="Cases" />
  <main class="max-w-6xl mx-auto px-lg py-xl grid grid-cols-1 md:grid-cols-[260px_1fr] gap-xl">
    <!-- Left rail: certification register -->
    <aside>
      <div class="font-label text-label uppercase text-ink-muted">
        <a href={`/cases/${r.caseKey}`} class="hover:text-primary">{r.caseTitle}</a> — all treatments
      </div>
      <div class="font-data text-data text-ink mt-xs">{r.treatmentName} · {r.tool} · rendering {r.n + 1} of {r.total}</div>

      <div class="mt-lg border border-line bg-paper p-md">
        <div class="font-label text-label uppercase text-ink-muted mb-xs">Distance</div>
        <p class="text-body" style="font-size:13px">This rendering landed <span class="font-data text-data text-ink bg-accent-wash px-1">{r.distance?.toFixed(2)}</span> from the model's default look.</p>
      </div>

      <div class="mt-md border border-line bg-paper p-md">
        <div class="font-label text-label uppercase text-ink-muted mb-sm">Field marks</div>
        {r.fieldMarks.map((f) => (
          <div class="flex items-baseline justify-between border-b border-line py-1 last:border-0">
            <span class="text-body" style="font-size:13px">{f.label}</span>
            <span class="font-data text-data text-ink-muted">{f.value}</span>
          </div>
        ))}
      </div>
    </aside>

    <!-- The artifact: the largest object on the page, in minimal browser chrome
         so it's clearly a live rendering. Frame width matches the scaled iframe. -->
    <div>
      <div class="flex justify-center">
        <BrowserFrame
          src={r.samplePath}
          address={`design-bench.local${r.samplePath}`}
          title={`${r.treatmentName} — ${r.caseTitle}`}
          width="760px"
          bodyStyle="height:460px"
          iframeStyle="width:1267px;height:1133px;transform:scale(0.6);"
        />
      </div>
      <p class="font-data text-data text-ink-muted mt-sm">Generated by {r.tool} on {r.date}. The model received the shared palette and type, plus the grounding below.</p>

      <div class="mt-lg border-t border-line pt-md max-w-prose">
        <div class="font-label text-label uppercase text-ink-muted mb-sm">The exact words</div>
        <div class="md" set:html={exactWordsHtml} />
        <p class="text-body text-ink-muted mt-md" style="font-size:13px">Identical color and type tokens were attached to every treatment in this case; only these words varied.</p>
      </div>
    </div>
  </main>

  <style>
    /* Render the grounding markdown in the house voice (set:html children can't take Tailwind classes). */
    .md :global(h2) { font: 500 12px/1.3 "IBM Plex Sans", system-ui, sans-serif; letter-spacing: 0.04em; text-transform: uppercase; color: #6b6a74; margin: 1.5rem 0 0.4rem; }
    .md :global(h2:first-child) { margin-top: 0; }
    .md :global(p) { font-size: 15px; line-height: 1.6; color: #1c1b22; margin: 0 0 0.7rem; }
    .md :global(ul) { font-size: 14px; line-height: 1.55; color: #1c1b22; margin: 0 0 0.7rem; padding-left: 1.1rem; list-style: disc; }
    .md :global(li) { margin: 0.15rem 0; }
    .md :global(strong) { font-weight: 600; }
    .md :global(em) { font-style: italic; }
  </style>
</Base>
