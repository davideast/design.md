---
import Base from "../../layouts/Base.astro";
import TopRail from "../../components/TopRail.astro";
import { runOptions } from "../../lib/makers";
const o = runOptions();
---
<Base title="New measurement batch — Design Bench">
  <TopRail active="All measurements" />
  <main class="max-w-3xl mx-auto px-lg py-xl" data-run>
    <div class="font-label text-label uppercase text-ink-muted mb-sm">
      <a href="/measurements" class="hover:text-primary">Measurements</a> · new batch
    </div>
    <h1 class="text-display font-display tracking-tight">New measurement batch</h1>

    <!-- 2. The experiment -->
    <section class="mt-xl">
      <div class="font-label text-label uppercase text-ink mb-sm">The experiment — what question is this batch asking</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
        {o.experiments.map((e, i) => (
          <label class="db-exp block border border-line bg-paper p-md cursor-pointer hover:ring-1 hover:ring-primary" style="border-radius:4px">
            <input type="radio" name="experiment" value={e.key} checked={i === 0} class="sr-only" />
            <div class="font-display font-semibold text-base text-ink">{e.name}</div>
            <p class="text-body text-ink-muted mt-1" style="font-size:12.5px;line-height:1.45">{e.blurb}</p>
          </label>
        ))}
      </div>
      <p class="text-body text-ink-muted mt-sm" style="font-size:12.5px">The experiment sets the axis — what varies across arms — and the metric follows from it.</p>
    </section>

    <!-- 3a. Arms: treatments (method grounding) -->
    <section class="mt-xl border-t border-line pt-lg" data-arms="method-grounding">
      <div class="font-label text-label uppercase text-ink mb-sm">The arms — the grounding ladder</div>
      <div class="flex flex-wrap gap-sm">
        {o.treatments.map((t) => (
          <label class="db-chip" data-locked={t.locked ? "1" : "0"}>
            <input type="checkbox" name="treatment" value={t.key} checked disabled={t.locked} class="sr-only" />
            <span>{t.name}</span>{t.note && <span class="db-chip-note"> · {t.note}</span>}
          </label>
        ))}
      </div>
      <p class="text-body text-ink-muted mt-sm" style="font-size:12.5px">Adjectives is the comparison baseline and is always included; no direction is the control.</p>
    </section>

    <!-- 3b. Arms: tools (tool comparison) -->
    <section class="mt-xl border-t border-line pt-lg hidden" data-arms="tool-comparison">
      <div class="font-label text-label uppercase text-ink mb-sm">The arms — the tools to compare</div>
      <div class="flex flex-wrap gap-sm">
        {o.tools.map((t) => (
          <label class={`db-chip ${t.available ? "" : "db-chip-off"}`}>
            <input type="checkbox" name="tool-arm" value={t.key} checked={t.available} disabled={!t.available} class="sr-only" />
            <span>{t.name}</span>{!t.available && <span class="db-chip-note"> · no key</span>}
          </label>
        ))}
      </div>
      <p class="text-body text-ink-muted mt-sm" style="font-size:12.5px">Every selected tool renders the same fixed direction (full specification); that's what makes them comparable. A tool needs a key — set one in <a href="/settings" class="text-primary hover:underline">Settings</a>.</p>
    </section>

    <!-- 4. Cases -->
    <section class="mt-xl border-t border-line pt-lg">
      <div class="font-label text-label uppercase text-ink mb-sm">Cases</div>
      <div class="flex flex-wrap gap-sm">
        {o.cases.map((c, i) => (
          <label class="db-chip">
            <input type="checkbox" name="case" value={c.key} checked={i === 0} class="sr-only" />
            <span>{c.title}</span>
          </label>
        ))}
      </div>
      <p class="text-body text-ink-muted mt-sm" style="font-size:12.5px">Each selected case is rendered for every arm above.</p>
    </section>

    <!-- 5. The tool (method grounding only) -->
    <section class="mt-xl border-t border-line pt-lg" data-arms="method-grounding">
      <div class="font-label text-label uppercase text-ink mb-sm">The tool</div>
      <div class="flex flex-wrap gap-sm">
        {o.tools.map((t, i) => (
          <label class={`db-chip db-radio ${t.available ? "" : "db-chip-off"}`}>
            <input type="radio" name="mg-tool" value={t.key} checked={i === 0} disabled={!t.available} class="sr-only" />
            <span>{t.name}</span>
          </label>
        ))}
      </div>
      <p class="text-body text-ink-muted mt-sm" style="font-size:12.5px">One tool, so every treatment's distance is measured from the same default look.</p>
    </section>

    <!-- 6. Channels -->
    <section class="mt-xl border-t border-line pt-lg">
      <div class="font-label text-label uppercase text-ink mb-sm">Channels — how the direction is delivered</div>
      <div class="flex flex-wrap gap-sm">
        {o.channels.map((ch, i) => (
          <label class="db-chip">
            <input type="checkbox" name="channel" value={ch.key} checked={ch.key === "prompt" || i === 0} class="sr-only" />
            <span>{ch.name}</span>
          </label>
        ))}
      </div>
      <p class="text-body text-ink-muted mt-sm" style="font-size:12.5px">Only Stitch offers the design-system channel; raw model tools receive the direction in the prompt, so a fair tool comparison uses the prompt channel for all of them.</p>
    </section>

    <!-- 7. The metric (a consequence) -->
    <section class="mt-xl border-t border-line pt-lg">
      <div class="font-label text-label uppercase text-ink mb-xs">The metric</div>
      <p class="text-body" data-metric>—</p>
    </section>

    <!-- 8. How many + cost -->
    <section class="mt-xl border-t border-line pt-lg">
      <div class="font-label text-label uppercase text-ink mb-sm">How many</div>
      <div class="flex items-center gap-lg flex-wrap">
        <label class="block">
          <span class="font-label text-label uppercase text-ink-muted block mb-1">Renderings per arm</span>
          <input type="number" name="per-arm" value="8" min="1" class="db-num" />
        </label>
        <label class="block" data-arms="method-grounding">
          <span class="font-label text-label uppercase text-ink-muted block mb-1">Control renderings</span>
          <input type="number" name="control" value="8" min="0" class="db-num" />
        </label>
      </div>
      <p class="text-body mt-md border-l-2 border-primary pl-md" data-cost>—</p>
    </section>

    <!-- 9. Model and name -->
    <section class="mt-xl border-t border-line pt-lg">
      <div class="font-label text-label uppercase text-ink mb-sm">The model and the name</div>
      <div class="flex items-center gap-lg flex-wrap">
        <label class="block">
          <span class="font-label text-label uppercase text-ink-muted block mb-1">Model</span>
          <select name="model" class="db-num">{o.models.map((m) => <option value={m}>{m}</option>)}</select>
        </label>
        <label class="block">
          <span class="font-label text-label uppercase text-ink-muted block mb-1">Batch name</span>
          <input type="text" name="name" value="october-baseline" class="db-num" style="min-width:200px" />
        </label>
      </div>
    </section>

    <!-- 10. Launch -->
    <section class="mt-xl border-t border-line pt-lg">
      <button data-launch class="font-label text-label uppercase bg-primary text-paper px-md py-2 hover:opacity-90" style="border-radius:2px">Generate and measure</button>
      <p class="text-body text-ink-muted mt-sm max-w-prose" style="font-size:12.5px">
        The batch records the experiment, the tool(s), and the exact case definitions it measured, identified by
        hash, and refuses to resume if any of them change underneath it. Progress is visible from the measurements
        page; batches are resumable. Generation runs locally — this builds the exact command to run:
      </p>
      <pre data-command class="mt-sm bg-ink text-paper p-md font-data" style="font-size:12px;border-radius:4px;line-height:1.5;white-space:pre-wrap;word-break:break-word">—</pre>
    </section>
  </main>
</Base>

<style>
  .db-chip { display: inline-flex; align-items: baseline; gap: 2px; border: 1px solid #d8d8dc; padding: 6px 12px; border-radius: 9999px; cursor: pointer; font: 500 12px/1 "IBM Plex Sans", sans-serif; letter-spacing: 0.02em; text-transform: uppercase; color: #1c1b22; user-select: none; }
  .db-chip:hover { border-color: #6d4de3; }
  .db-chip:has(input:checked) { background: #efebfd; border-color: #6d4de3; color: #6d4de3; }
  .db-chip:has(input:disabled) { cursor: not-allowed; }
  .db-chip[data-locked="1"] { opacity: 0.85; }
  .db-chip-off { opacity: 0.45; cursor: not-allowed; }
  .db-chip-note { color: #6b6a74; text-transform: none; font-weight: 400; }
  .db-chip:has(input:checked) .db-chip-note { color: #6d4de3; }
  .db-exp:has(input:checked) { outline: 2px solid #6d4de3; outline-offset: -1px; }
  .db-num { border: 1px solid #d8d8dc; border-radius: 2px; padding: 6px 10px; font: 400 14px "IBM Plex Mono", monospace; color: #1c1b22; background: #fff; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-run]");
  if (root) {
    const $ = <T extends Element>(s: string) => Array.from(root.querySelectorAll<T>(s));
    const exp = () => (root.querySelector<HTMLInputElement>('input[name="experiment"]:checked')?.value ?? "method-grounding");
    const checked = (name: string) => $<HTMLInputElement>(`input[name="${name}"]`).filter((i) => i.checked && !i.disabled).map((i) => i.value);
    const num = (name: string) => Number(root.querySelector<HTMLInputElement>(`input[name="${name}"]`)?.value ?? "0");

    function syncSections() {
      const e = exp();
      for (const el of $<HTMLElement>("[data-arms]")) el.classList.toggle("hidden", el.dataset.arms !== e);
    }

    function render() {
      const e = exp();
      const cases = checked("case");
      const channels = e === "tool-comparison" ? ["prompt"] : checked("channel");
      const arms = e === "tool-comparison" ? checked("tool-arm") : checked("treatment");
      const perArm = num("per-arm");
      const nCh = Math.max(channels.length, 1);

      // metric follows from the experiment
      const metric = root.querySelector<HTMLElement>("[data-metric]")!;
      metric.innerHTML = e === "tool-comparison"
        ? "Scored by <b>fidelity to the handed direction</b> — how faithfully each tool reproduced the palette and type. The only measure comparable across tools."
        : "Scored by <b>distance from the tool's default look</b> — how far the direction pushed the result from the lazy default.";

      // cost arithmetic
      const renders = perArm * cases.length * arms.length * nCh;
      const controls = e === "method-grounding" ? num("control") * cases.length : 0;
      const cost = root.querySelector<HTMLElement>("[data-cost]")!;
      const chPhrase = e === "tool-comparison" ? "the prompt channel" : `${nCh} channel${nCh === 1 ? "" : "s"}`;
      cost.innerHTML = `<b>${perArm}</b> per arm across <b>${cases.length}</b> case${cases.length === 1 ? "" : "s"}, <b>${arms.length}</b> arm${arms.length === 1 ? "" : "s"}, and ${chPhrase} is <b>${renders}</b> rendering${renders === 1 ? "" : "s"}${controls ? `, plus <b>${controls}</b> control${controls === 1 ? "" : "s"}` : ""}.`;

      // the honest "launch": the exact command
      const name = (root.querySelector<HTMLInputElement>('input[name="name"]')?.value || "batch").trim();
      const model = root.querySelector<HTMLSelectElement>('select[name="model"]')?.value;
      const tool = e === "method-grounding" ? (root.querySelector<HTMLInputElement>('input[name="mg-tool"]:checked')?.value ?? "stitch") : null;
      const cfg: Record<string, unknown> = { name, experiment: e, cases, arms, channels, samples: perArm, model };
      if (e === "method-grounding") { cfg.tool = tool; cfg.controlSamples = num("control"); cfg.metric = "escape-from-center"; }
      else { cfg.metric = "fidelity-to-direction"; }
      const cmd = root.querySelector<HTMLElement>("[data-command]")!;
      cmd.textContent = `bun run bench \\\n  --config '${JSON.stringify(cfg)}'`;
    }

    root.addEventListener("change", () => { syncSections(); render(); });
    root.addEventListener("input", render);
    root.querySelector("[data-launch]")?.addEventListener("click", (e) => { e.preventDefault(); render(); });
    syncSections();
    render();
  }
</script>
