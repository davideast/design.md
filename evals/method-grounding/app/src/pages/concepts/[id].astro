---
import Base from "../../layouts/Base.astro";
import TopRail from "../../components/TopRail.astro";
import { listConcepts, conceptView } from "../../lib/makers";
import { settingsView } from "../../lib/makers";

export function getStaticPaths() {
  return listConcepts().map((c) => ({ params: { id: c.id } }));
}
const { id } = Astro.params;
const c = conceptView(id!)!;
const agent = settingsView().agentProvider;
const ready = c.captured.brief && c.captured.direction;
const tick = (on: boolean) => (on ? "✓" : "—");
---
<Base title={`Ideation — Design Bench`}>
  <TopRail active="Cases" />
  <main class="max-w-6xl mx-auto px-lg py-xl grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-xl">
    <!-- Region 1: the captured artifacts -->
    <div>
      <!-- 1. Wayfinding and the spark -->
      <div class="font-label text-label uppercase text-ink-muted mb-sm">
        <a href="/" class="hover:text-primary">All cases</a> · ideation
      </div>
      <h1 class="text-display font-display tracking-tight">Find the world</h1>
      <p class="text-body text-ink-muted mt-xs max-w-prose">The spark that started this concept: <span class="text-ink">“{c.spark}”</span></p>

      <!-- 2. Captured brief -->
      <section class="mt-xl border-t border-line pt-lg">
        <div class="flex items-baseline justify-between">
          <span class="font-label text-label uppercase text-ink">Captured brief</span>
          <span class="font-data text-data text-ink-muted">{c.captured.brief ? `${c.briefLines} lines` : ""}</span>
        </div>
        {c.captured.brief ? (
          <div class="mt-sm max-w-prose">
            {c.briefTitle && <div class="font-display font-semibold text-base text-ink mb-1">{c.briefTitle}</div>}
            <p class="text-body" style="font-size:15px;line-height:1.6">{c.briefProse}</p>
          </div>
        ) : (
          <p class="text-body text-ink-muted mt-sm max-w-prose">Nothing yet — converge on content in the conversation; the agent captures only when you agree.</p>
        )}
      </section>

      <!-- 3. Captured direction -->
      <section class="mt-xl border-t border-line pt-lg">
        <div class="flex items-baseline justify-between">
          <span class="font-label text-label uppercase text-ink">Captured direction</span>
          <span class="font-data text-data text-ink-muted">{c.captured.direction ? `${c.directionLines} lines` : ""}</span>
        </div>
        {c.captured.direction ? (
          <div class="mt-sm max-w-prose">
            {c.directionTokens && <div class="font-data text-data text-ink-muted mb-1">{c.directionTokens}</div>}
            <p class="text-body" style="font-size:15px;line-height:1.6">{c.directionProse}</p>
          </div>
        ) : (
          <p class="text-body text-ink-muted mt-sm max-w-prose">Nothing yet — the agent captures a direction only when you agree on one.</p>
        )}
      </section>

      <!-- 4. Commit -->
      <section class="mt-xl border-t border-line pt-lg max-w-prose">
        <div class="font-label text-label uppercase text-ink mb-sm">Commit</div>
        <div class="flex items-center gap-sm flex-wrap">
          <div class="border border-line px-sm py-2 font-data text-data text-ink-muted" style="border-radius:2px;min-width:180px">case short name…</div>
          <button class="font-label text-label uppercase bg-primary text-paper px-md py-2 disabled:opacity-40" style="border-radius:2px" disabled={!ready}>Commit — project into treatments</button>
        </div>
        <p class="text-body text-ink-muted mt-sm" style="font-size:12.5px">
          Committing scaffolds the case from the captured direction and writes all treatments from it. It's available
          once both artifacts are captured{ready ? "" : " (not yet)"} — and it's yours; the agent never commits.
        </p>
      </section>
    </div>

    <!-- Region 2: the conversation -->
    <aside class="lg:sticky lg:top-16 self-start">
      <div class="border border-line bg-paper flex flex-col" style="border-radius:8px;max-height:calc(100vh-6rem)">
        <div class="px-md py-sm border-b border-line flex items-baseline justify-between">
          <span class="font-label text-label uppercase text-ink">Ideation agent</span>
          <span class="font-data text-data text-ink-muted">{agent}</span>
        </div>
        <div class="px-md py-sm border-b border-line font-data text-data text-ink-muted">
          brief {tick(c.captured.brief)} · direction {tick(c.captured.direction)} {ready ? "— ready to commit" : "— keep converging"}
        </div>
        <div class="px-md py-md flex-1 overflow-auto">
          <p class="text-body text-ink-muted" style="font-size:13px;line-height:1.55">
            A conversation, not a generator: diverge on worlds that escape the generic center, converge on a brief
            and a direction, capture each only when you agree. Runs on this machine through <span class="font-data text-data">{agent}</span>.
          </p>
        </div>
        <div class="px-md py-sm border-t border-line">
          <div class="flex flex-wrap gap-1 mb-sm">
            {["3 worlds", "name the enemy", "directions", "capture brief", "capture direction"].map((q) => (
              <span class="font-label text-label uppercase text-ink-muted border border-line px-2 py-1" style="border-radius:9999px">{q}</span>
            ))}
          </div>
          <div class="border border-line px-sm py-2 text-ink-muted font-body" style="font-size:13px;border-radius:2px">React, redirect, choose…</div>
        </div>
      </div>
    </aside>
  </main>
</Base>
