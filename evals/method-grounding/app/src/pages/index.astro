---
import Base from "../layouts/Base.astro";
import TopRail from "../components/TopRail.astro";
import { PROVIDERS, bestArm, gridTiles } from "../lib/bench";
import { CASE_TITLES, CASE_WORLDS } from "../lib/runs";

const rows = Array.from(new Set(gridTiles().map((t) => t.caseKey)));
const cols = PROVIDERS;
const caseNo = (i: number) => String(i + 1).padStart(2, "0");
// Labels hang into the left gutter; the first proof sheet aligns with the title.
// LEFT_MARGIN keeps the hanging labels off the viewport edge (aligned with the masthead).
const LABEL_W = 220;
const GAP = 32; // table showing between sheets; also crop-mark clearance
const LEFT_MARGIN = 24;
const TITLE_X = LABEL_W + GAP + LEFT_MARGIN; // where the title + first sheet begin
---
<Base title="Design Bench">
  <TopRail active="Cases" />
  <main class="py-xl" style={`padding-left:${TITLE_X}px;padding-right:32px`}>
    <header class="mb-lg max-w-3xl">
      <h1 class="font-display text-display text-ink mb-sm">Design Bench</h1>
      <p class="font-body text-body text-ink-muted">
        The same brief, run through different AI design tools. Each cell is one tool's best result for that brief;
        open it to see every arm side by side. Down a column is one tool across briefs; across a row is the tools on one brief.
      </p>
    </header>

    <!-- The press table: column/row labels printed on the neutral surround; each
         result is a paper proof sheet laid on it, the table showing in the gaps. -->
    <div class="overflow-x-auto" style={`margin-left:-${LABEL_W + GAP}px`}>
      <div class="grid items-start" style={`grid-template-columns:${LABEL_W}px repeat(${cols.length}, minmax(170px,1fr));gap:${GAP}px;min-width:1280px`}>
        <!-- origin: axis label, on the table -->
        <div class="self-end pb-xs font-data text-data text-ink-muted" style="font-size:9px">CASE \ TOOL</div>

        <!-- provider column headers, printed on the table -->
        {cols.map((p) => (
          <div class="self-end border-b border-line pb-xs">
            <div class="font-label text-label uppercase tracking-wider text-ink leading-tight">{p.label}</div>
            {p.runs.length === 0 && <div class="font-data text-data text-ink-muted mt-1" style="font-size:9px">no key</div>}
          </div>
        ))}

        <!-- one row per case -->
        {rows.map((caseKey, i) => (
          <>
            <div class="pt-xs">
              <div class="font-data text-data text-ink-muted" style="font-size:9px">CASE {caseNo(i)}</div>
              <div class="font-display font-semibold text-ink mt-1" style="font-size:15px;line-height:1.2">{CASE_TITLES[caseKey] ?? caseKey}</div>
              <p class="font-body text-ink-muted mt-1" style="font-size:11.5px;line-height:1.4">{CASE_WORLDS[caseKey] ?? ""}</p>
            </div>

            {cols.map((p) => {
              const best = bestArm(p.key, caseKey);
              if (best) {
                // A proof sheet: paper, the render inset on a paper margin, a
                // caption slug, corner crop marks. The artwork sits ON the sheet.
                return (
                  <a href={`/r/${p.key}/${caseKey}`} class="relative bg-paper p-2 block group hover:z-10">
                    <div class="crop-mark-tl"></div><div class="crop-mark-tr"></div>
                    <div class="crop-mark-bl"></div><div class="crop-mark-br"></div>
                    <div class="relative overflow-hidden border border-line bg-neutral group-hover:border-primary" style="aspect-ratio:16/10">
                      <iframe src={best.render} scrolling="no" tabindex="-1" loading="lazy"
                        class="absolute top-0 left-0 origin-top-left border-0 pointer-events-none"
                        style="width:1280px;height:800px;transform:scale(0.225)"></iframe>
                    </div>
                    <div class="flex items-baseline justify-between pt-2">
                      <span class="font-label text-ink-muted group-hover:text-primary" style="font-size:9px;text-transform:uppercase;letter-spacing:0.04em">{best.name}</span>
                      <span class="font-data text-ink-muted" style="font-size:8px;opacity:0.7">{p.key}</span>
                    </div>
                  </a>
                );
              }
              // Empty slot: bare table, faint label — no paper, no white.
              const reason = p.runs.length === 0 ? "no key" : "awaiting run";
              return (
                <div class="flex items-center justify-center h-full" style="min-height:170px">
                  <span class="font-data text-ink-muted" style="font-size:10px;opacity:0.4">{reason}</span>
                </div>
              );
            })}
          </>
        ))}
      </div>
    </div>

    <p class="font-data text-data text-ink-muted mt-lg" style="font-size:11px">
      Each sheet is the tool's best render for that brief, measured on this machine — open one to see every arm. Empty slots are tools not yet run.
    </p>
  </main>
</Base>
