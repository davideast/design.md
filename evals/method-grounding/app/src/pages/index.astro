---
import Base from "../layouts/Base.astro";
import TopRail from "../components/TopRail.astro";
import ProofThumb from "../components/ProofThumb.astro";
import { gridTiles } from "../lib/bench";
import { CASE_TITLES, CASE_WORLDS } from "../lib/runs";
const tiles = gridTiles();
// Group by design type so the page reads as "designs, across providers".
const byCase = new Map<string, typeof tiles>();
for (const t of tiles) {
  if (!byCase.has(t.caseKey)) byCase.set(t.caseKey, []);
  byCase.get(t.caseKey)!.push(t);
}
---
<Base title="Design Bench">
  <TopRail active="Cases" />
  <main class="max-w-6xl mx-auto px-lg py-xl">
    <h1 class="text-display font-display tracking-tight">Design Bench</h1>
    <p class="text-body text-ink-muted mt-xs max-w-prose">
      The same brief, run through different AI design tools. Each tile is one tool's best result for that brief —
      open it to see every arm side by side.
    </p>

    {[...byCase.entries()].map(([caseKey, group]) => (
      <section class="mt-xl">
        <div class="flex items-baseline justify-between border-b border-line pb-xs mb-md">
          <span class="font-display font-semibold text-base text-ink">{CASE_TITLES[caseKey] ?? caseKey}</span>
          <span class="font-label text-label uppercase text-ink-muted">{CASE_WORLDS[caseKey] ?? ""}</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg">
          {group.map((t) => (
            <a href={`/r/${t.providerKey}/${t.caseKey}`} class="block group">
              <ProofThumb src={t.best?.render} />
              <div class="mt-sm flex items-baseline justify-between">
                <span class="font-label text-label uppercase text-ink group-hover:text-primary">{t.providerLabel}</span>
                <span class="font-label text-label uppercase text-ink-muted">{t.best?.name}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</Base>
