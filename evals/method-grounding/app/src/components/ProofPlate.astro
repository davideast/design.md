---
// A render mounted on the press table: a sharp-cornered proof sheet with corner
// registration (crop) marks, the live browser render pinned to it, and a CMYK
// press color bar beneath that carries the palette-fidelity reading. The render
// keeps its browser chrome (it really is a live page); the proof sheet is the
// proofing context around it. Used on the home + comparison surfaces.
import ProofThumb from "./ProofThumb.astro";
const { src, providerName, fidelity, pending, href, note } = Astro.props;
const pct = fidelity != null ? Math.round(fidelity * 100) : null;
// The press color bar: process inks + the two house spot colors.
const bar = ["#29abe2", "#ec008c", "#fff200", "#1c1b22", "#6d4de3", "#5b6fe0", "#b45cc9", "#e9e9ec"];
const Tag = href ? "a" : "div";
---
<Tag href={href} class={`proof-plate block bg-paper border border-line ${href ? "group" : ""}`}>
  <div class="plate-inner relative p-md">
    <span class="crop crop-tl"></span><span class="crop crop-tr"></span>
    <span class="crop crop-bl"></span><span class="crop crop-br"></span>

    <div class="flex items-baseline justify-between mb-sm">
      <span class={`font-label text-label uppercase text-ink ${href ? "group-hover:text-primary" : ""}`}>{providerName}</span>
      {note && <span class="font-label text-label uppercase text-ink-muted">{note}</span>}
    </div>

    <ProofThumb src={src} />

    <!-- press color bar + the measured reading it stands in for -->
    <div class="mt-sm">
      <div class="flex h-2.5" style="gap:1px">
        {bar.map((c) => <span style={`background:${c};flex:1`}></span>)}
      </div>
      <div class="mt-xs flex items-baseline justify-between">
        <span class="font-label text-label uppercase text-ink-muted">Palette fidelity</span>
        {pending ? (
          <span class="font-label text-label uppercase text-ink-muted">measurement pending</span>
        ) : (
          <span class="font-data text-ink" style="font-size:22px;line-height:1">{pct}%</span>
        )}
      </div>
      {!pending && pct != null && (
        <div class="mt-1 h-1 bg-neutral overflow-hidden">
          <div class="h-full bg-primary" style={`width:${pct}%`}></div>
        </div>
      )}
    </div>
  </div>
</Tag>

<style>
  /* Sharp corners — the proof sheet, not a browser window. */
  .proof-plate { border-radius: 0; }
  .plate-inner { padding: 20px; }
  /* Corner registration / crop marks, drawn in the sheet's margin. */
  .crop { position: absolute; width: 10px; height: 10px; pointer-events: none; }
  .crop-tl { top: 7px; left: 7px; border-top: 1px solid #1c1b22; border-left: 1px solid #1c1b22; }
  .crop-tr { top: 7px; right: 7px; border-top: 1px solid #1c1b22; border-right: 1px solid #1c1b22; }
  .crop-bl { bottom: 7px; left: 7px; border-bottom: 1px solid #1c1b22; border-left: 1px solid #1c1b22; }
  .crop-br { bottom: 7px; right: 7px; border-bottom: 1px solid #1c1b22; border-right: 1px solid #1c1b22; }
</style>
