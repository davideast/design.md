---
// A live thumbnail of a real generated rendering, wrapped in minimal browser
// chrome so it's clearly a web page, not an image. The iframe is overscaled to
// fill the cell width and clipped — a preview of the page's top-left.
import BrowserFrame from "./BrowserFrame.astro";
const { src } = Astro.props;
---
<BrowserFrame src={src} mini bodyStyle="aspect-ratio:16/10" iframeStyle="width:1280px;height:900px;transform:scale(0.45);" />
