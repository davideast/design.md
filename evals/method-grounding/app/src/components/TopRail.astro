---
const { active } = Astro.props;
const linkClass = (label: string) =>
  `font-label text-label pb-1 ${active === label ? "text-primary border-b-2 border-primary" : "text-ink-muted hover:text-primary"} transition-colors`;
---
<!-- The grid is the navigation: the logo returns to the wall of results.
     Measurements / compare are secondary and reached on demand, not from the spine. -->
<nav class="bg-paper border-b border-line h-12 flex items-center justify-between px-lg sticky top-0 z-50">
  <a href="/" class="font-display font-semibold tracking-tight text-base text-ink">Design Bench</a>
  <a href="/settings" class={`hidden md:inline ${linkClass("Settings")}`}>Settings</a>
</nav>
