---
import Base from "../../layouts/Base.astro";
import TopRail from "../../components/TopRail.astro";
import ProofThumb from "../../components/ProofThumb.astro";
import { listCases, caseView } from "../../lib/runs";

export function getStaticPaths() {
  return listCases().map((c) => ({ params: { case: c.key } }));
}
const { case: caseKey } = Astro.params;
const v = caseView(caseKey!)!;
---
<Base title={`${v.title} — Design Bench`}>
  <TopRail active="Cases" />
  <main class="max-w-6xl mx-auto px-lg py-xl">
    <div class="font-label text-label uppercase text-ink-muted mb-sm">
      <a href="/" class="hover:text-primary">All cases</a> · {v.title}
    </div>
    <h1 class="text-display font-display tracking-tight">{v.title}</h1>
    <p class="text-body text-ink-muted mt-xs max-w-prose">{v.world} Every rendering below was asked for exactly the same brief; only the design direction changed.</p>

    <!-- The claim — real measured result -->
    <p class="text-body mt-lg max-w-prose border-l-2 border-primary pl-md">{v.headline}</p>

    <!-- Try it blind before reading the labels -->
    <a href={`/cases/${v.key}/judge`} class="inline-flex items-baseline gap-sm mt-md font-label text-label uppercase text-primary hover:underline">
      Judge these blind first → <span class="text-ink-muted">pick the strongest, then see the measurement</span>
    </a>

    <!-- The treatment spread: one tool, increasing direction -->
    <div class="mt-xl flex items-center justify-between border-b border-line pb-xs">
      <span class="font-label text-label uppercase text-ink">{v.tool}</span>
      <span class="font-label text-label uppercase text-ink-muted">distance from the default look</span>
    </div>

    <div class="mt-md grid grid-cols-2 md:grid-cols-4 gap-md">
      {v.treatments.map((t) => (
        <a href={`/cases/${v.key}/${t.key}`} class={`block group ${t.key === "object" ? "ring-1 ring-primary" : ""}`}>
          <ProofThumb src={t.samplePath} label={t.name} />
          <div class="mt-sm flex items-baseline justify-between">
            <span class="font-label text-label uppercase text-ink group-hover:text-primary">{t.name}</span>
            <span class="font-data text-data text-ink bg-accent-wash px-1">{t.isControl ? "0.00" : t.distance?.toFixed(2) ?? "—"}</span>
          </div>
          <p class="text-body text-ink-muted mt-xs" style="font-size:13px;line-height:1.4">{t.blurb}</p>
          <span class="font-label text-label uppercase text-ink-muted group-hover:text-primary">{t.samples} renderings →</span>
        </a>
      ))}
    </div>

    <!-- How to read -->
    <div class="mt-xl border-t border-line pt-md max-w-prose">
      <div class="font-label text-label uppercase text-ink-muted mb-sm">How to read the numbers</div>
      <p class="text-body" style="font-size:13.5px"><b>Distance</b> is how far a rendering moved from this tool's default look (what it produces with no direction). Higher means the direction pushed it farther from the lazy default. Every distance here is measured against the same <span class="font-data text-data">{v.tool}</span> control.</p>
    </div>

    <!-- Certification -->
    <div class="mt-lg border-t border-line pt-sm font-data text-data text-ink-muted">
      tool {v.tool} · {v.measuredCount} renderings measured · definitions {v.evalHash} · metric: distance from default look
    </div>
  </main>
</Base>
