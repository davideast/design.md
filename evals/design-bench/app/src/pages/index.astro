---
import Base from "../layouts/Base.astro";
import TopRail from "../components/TopRail.astro";
import { featuredProviders, providerCount, bestArm, gridTiles, CASE_TITLES, CASE_WORLDS } from "../lib/data";

const tiles = gridTiles();
const rows = Array.from(new Set(tiles.map((t) => t.caseKey)));
const cols = featuredProviders();
const totalProviders = providerCount();
const caseNo = (i: number) => String(i + 1).padStart(2, "0");
const LABEL_W = 200;
const COL_MIN = 200;
---
<Base title="Design Bench">
  <div id="page-shell">
    <TopRail />

    <div id="home-wrap">
      <!-- ═══ MOBILE: stacked sections (< 768px) ═══ -->
      <div id="mobile-grid">
        <div class="px-md py-sm border-b border-line flex items-baseline justify-between">
          <span class="font-data text-data text-ink-muted" style="font-size:9px">{cols.length} of {totalProviders} tools</span>
          {totalProviders > cols.length && (
            <a href="/matrix" class="font-label text-label uppercase text-primary hover:underline" style="font-size:9px">
              See all {totalProviders} →
            </a>
          )}
        </div>

        {rows.map((caseKey, i) => (
          <div class="mb-md">
            {/* Case header — full width, compact */}
            <div class="px-md py-sm border-b border-line">
              <span class="font-data text-data text-ink-muted" style="font-size:9px">CASE {caseNo(i)}</span>
              <a href={`/cases/${caseKey}`} class="font-display font-semibold text-ink hover:text-primary block" style="font-size:15px;line-height:1.2">
                {CASE_TITLES[caseKey] ?? caseKey}
              </a>
            </div>

            {/* Screens — horizontal scroll row */}
            <div class="flex gap-md overflow-x-auto px-md py-sm" style="-webkit-overflow-scrolling:touch">
              {cols.map((p) => {
                const best = bestArm(p.key, caseKey);
                if (best) {
                  return (
                    <a href={`/r/${p.key}/${caseKey}`} class="block group flex-shrink-0" style="width:260px">
                      <div class="bg-paper p-1.5">
                        <div class="relative overflow-hidden border border-line bg-neutral group-hover:border-primary db-frame" style="aspect-ratio:16/10">
                          <iframe src={best.render} scrolling="no" tabindex="-1" loading="lazy"
                            class="absolute top-0 left-0 origin-top-left border-0 pointer-events-none"
                            style="width:1280px;height:800px"></iframe>
                        </div>
                      </div>
                      <div class="flex items-baseline justify-between pt-1 px-1">
                        <span class="font-label text-ink-muted group-hover:text-primary" style="font-size:8px;text-transform:uppercase;letter-spacing:0.04em">{best.name}</span>
                        <span class="font-data text-ink-muted" style="font-size:8px;opacity:0.7">{p.label}</span>
                      </div>
                    </a>
                  );
                }
                return (
                  <div class="flex-shrink-0 flex items-center justify-center bg-paper border border-line" style="width:260px;aspect-ratio:16/10">
                    <span class="font-data text-ink-muted" style="font-size:10px;opacity:0.4">{p.runs.length === 0 ? "no key" : "awaiting run"}</span>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <!-- ═══ DESKTOP: spreadsheet grid (≥ 768px) ═══ -->
      <div id="desktop-grid" class="grid"
        style={`grid-template-columns:${LABEL_W}px repeat(${cols.length},minmax(${COL_MIN}px,1fr));min-width:${LABEL_W + cols.length * COL_MIN}px`}>

        <!-- STICKY ORIGIN -->
        <div class="sticky-origin flex flex-col justify-end pb-xs px-sm"
          style={`position:sticky;top:0;left:0;z-index:30;width:${LABEL_W}px;height:44px;border-bottom:1px solid var(--line)`}>
          <span class="font-data text-data text-ink-muted" style="font-size:9px">{cols.length} of {totalProviders} tools</span>
          {totalProviders > cols.length && (
            <a href="/matrix" class="font-label text-label uppercase text-primary hover:underline" style="font-size:9px">
              See all {totalProviders} →
            </a>
          )}
        </div>

        <!-- STICKY COLUMN HEADERS -->
        {cols.map((p) => (
          <div class="sticky-header flex items-end pb-xs px-sm border-b border-line"
            style="position:sticky;top:0;z-index:20;height:44px">
            <div class="font-label text-label uppercase tracking-wider text-ink leading-tight" style="font-size:11px">{p.label}</div>
          </div>
        ))}

        <!-- ROWS -->
        {rows.map((caseKey, i) => (
          <>
            <div class="sticky-label px-sm py-sm"
              style={`position:sticky;left:0;z-index:10;width:${LABEL_W}px`}>
              <div class="font-data text-data text-ink-muted" style="font-size:9px">CASE {caseNo(i)}</div>
              <a href={`/cases/${caseKey}`} class="font-display font-semibold text-ink hover:text-primary mt-1 block" style="font-size:14px;line-height:1.2">
                {CASE_TITLES[caseKey] ?? caseKey}
              </a>
              <p class="font-body text-ink-muted mt-1" style="font-size:10.5px;line-height:1.35;max-width:180px">
                {CASE_WORLDS[caseKey] ?? ""}
              </p>
            </div>

            {cols.map((p) => {
              const best = bestArm(p.key, caseKey);
              if (best) {
                return (
                  <a href={`/r/${p.key}/${caseKey}`} class="relative bg-paper p-2 block group hover:z-10">
                    <div class="relative overflow-hidden border border-line bg-neutral group-hover:border-primary db-frame" style="aspect-ratio:16/10">
                      <iframe src={best.render} scrolling="no" tabindex="-1" loading="lazy"
                        class="absolute top-0 left-0 origin-top-left border-0 pointer-events-none"
                        style="width:1280px;height:800px"></iframe>
                    </div>
                    <div class="flex items-baseline justify-between pt-2">
                      <span class="font-label text-ink-muted group-hover:text-primary" style="font-size:9px;text-transform:uppercase;letter-spacing:0.04em">{best.name}</span>
                      <span class="font-data text-ink-muted" style="font-size:8px;opacity:0.7">{p.key}</span>
                    </div>
                  </a>
                );
              }
              const reason = p.runs.length === 0 ? "no key" : "awaiting run";
              return (
                <div class="flex items-center justify-center h-full" style="min-height:150px">
                  <span class="font-data text-ink-muted" style="font-size:10px;opacity:0.4">{reason}</span>
                </div>
              );
            })}
          </>
        ))}
      </div>
    </div>
  </div>
</Base>

<style>
  html, body {
    overflow: hidden;
    height: 100dvh;
    height: 100vh;
  }
  @supports (height: 100dvh) {
    html, body { height: 100dvh; }
  }

  #page-shell {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    height: 100vh;
    overflow: hidden;
  }
  @supports (height: 100dvh) {
    #page-shell { height: 100dvh; }
  }

  #home-wrap {
    flex: 1;
    min-height: 0;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
  }

  .sticky-origin,
  .sticky-header,
  .sticky-label {
    background: var(--neutral, #e9e9ec);
  }

  #desktop-grid { gap: 24px; padding-bottom: 48px; }

  /* Mobile: show stacked, hide grid */
  #mobile-grid { display: block; padding-bottom: 48px; }
  #desktop-grid { display: none; }

  @media (min-width: 768px) {
    #mobile-grid { display: none; }
    #desktop-grid { display: grid; }
  }
</style>
