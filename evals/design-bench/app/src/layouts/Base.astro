---
import "../styles/global.css";
const { title = "Design Bench" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <!-- The press table surround = DESIGN.md `neutral`. Proof sheets (paper) lie on it. -->
  <body class="bg-neutral text-ink font-body min-h-screen">
    <slot />
  </body>
</html>
